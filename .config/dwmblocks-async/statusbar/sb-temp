#!/bin/sh

# Configuration: Set to 1 to show temperature in °C, 0 to show icon only
SHOW_TEMP=1
# Handle mouse click events from dwmblocks
case $BLOCK_BUTTON in
    3) setsid -f "${TERMINAL:-alacritty}" -e watch -n1 sensors ;; # Right-click: Open live sensors monitor
    2) setsid -f "${TERMINAL:-alacritty}" -e nvim "$0" ;;         # Middle-click: Edit script
esac
# 1. Read temperature from sysfs (fallback checks thermal_zone0 or thermal_zone1)
TEMP_FILE="/sys/class/thermal/thermal_zone0/temp"
[ ! -f "$TEMP_FILE" ] && TEMP_FILE="/sys/class/thermal/thermal_zone1/temp"

if [ -f "$TEMP_FILE" ]; then
    RAW_TEMP=$(cat "$TEMP_FILE")
    TEMP=$((RAW_TEMP / 1000))
else
    # Fallback to sensors command if sysfs isn't available
    TEMP=$(sensors 2>/dev/null | awk '/Package id 0:|Core 0:/ {print $4}' | tr -d '+°C' | head -n1 | cut -d. -f1)
fi

[ -z "$TEMP" ] && TEMP=0

# 2. Dynamic Icons based on temperature thresholds
if [ "$TEMP" -ge 80 ]; then
    ICON="" # High heat / throttling risk (>= 80°C)
elif [ "$TEMP" -ge 60 ]; then
    ICON="" # Medium load (60°C - 79°C)
else
    ICON="" # Cool / normal (< 60°C)
fi

# Output based on the toggle switch
if [ "$SHOW_TEMP" -eq 1 ]; then
    echo "$ICON ${TEMP}°C"
else
    echo "$ICON"
fi
