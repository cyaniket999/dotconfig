#!/bin/sh

# Configuration: Set to 1 to show percentage, 0 to show gauge bar only
SHOW_PERCENTAGE=0
# Handle mouse click events from dwmblocks
case $BLOCK_BUTTON in
    3) setsid -f "${TERMINAL:-alacritty}" -e htop ;;         # Right-click: Open htop
    2) setsid -f "${TERMINAL:-alacritty}" -e nvim "$0" ;;    # Middle-click: Edit script
esac
# Calculate CPU usage percentage
CPU_VAL=$(top -bn1 | grep "Cpu(s)" | awk '{printf "%d", 100 - $8}')
[ -z "$CPU_VAL" ] && CPU_VAL=0

# True Proportional Meter/Gauge Bar Scale
if [ "$CPU_VAL" -ge 88 ]; then
    BAR="█" # Peak Load
elif [ "$CPU_VAL" -ge 76 ]; then
    BAR="▇"
elif [ "$CPU_VAL" -ge 63 ]; then
    BAR="▆"
elif [ "$CPU_VAL" -ge 51 ]; then
    BAR="▅" # Half Load
elif [ "$CPU_VAL" -ge 38 ]; then
    BAR="▄"
elif [ "$CPU_VAL" -ge 26 ]; then
    BAR="▃"
elif [ "$CPU_VAL" -ge 13 ]; then
    BAR="▂"
else
    BAR=" " # Idle
fi

# Combine clean CPU chip icon with the dynamic meter bar
ICON=" $BAR"

# Output based on the toggle switch
if [ "$SHOW_PERCENTAGE" -eq 1 ]; then
    echo "$ICON ${CPU_VAL}%"
else
    echo "$ICON"
fi
