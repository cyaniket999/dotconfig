#!/bin/sh

# Handle mouse click events from dwmblocks
case $BLOCK_BUTTON in
    3) setsid -f "${TERMINAL:-alacritty}" -o window.dimensions.columns=22 -o window.dimensions.lines=10 -e sh -c "cal && echo && read -p 'Press Enter to close...'" ;; # Right-click: Open compact terminal calendar popup
    2) setsid -f "${TERMINAL:-alacritty}" -e nvim "$0" ;;                                                                                                                # Middle-click: Edit script
esac

# Output date format (Day/Month/Year) and time
#date '+%d/%m/%y %I:%M %p'
date '+%I:%M %p'
