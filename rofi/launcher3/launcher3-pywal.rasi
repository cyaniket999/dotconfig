/* Import dynamic colors from pywal */
@import "~/.cache/wal/colors-rofi-dark.rasi"

configuration {
    modi:                       "drun,run";
    show-icons:                 true;
    display-drun:               " Type to search...";
    drun-display-format:        "{name}";
    font:                       "JetBrainsMono Nerd Font, monospace 10";
}

* {
    /* Standardized variable mappings from Pywal */
    bg-col:                     @background;
    bg-alt:                     @selected-normal-background;
    border-col:                 @selected-normal-background;
    selected-col:               @selected-normal-background;
    fg-col:                     @foreground;
    fg-col-active:              @background;

    background-color:           transparent;
    text-color:                 @fg-col;
    margin:                     0;
    padding:                    0;
    spacing:                    0;
}

window {
    transparency:               "real";
    location:                   center;
    anchor:                     center;
    fullscreen:                 true;
    width:                      100%;
    height:                     100%;
    background-color:           #000000CC;
    padding:                    80px 150px;
}

mainbox {
    background-color:           transparent;
    children:                   [ inputbar, listview ];
    spacing:                    30px;
}

inputbar {
    background-color:           #111111CC;
    text-color:                 @fg-col;
    border-radius:              8px;
    padding:                    12px 16px;
    margin:                     0px 300px;
    children:                   [ prompt, entry ];
    border:                     1px;
    border-color:               @border-col;
}

prompt {
    background-color:           transparent;
    text-color:                 @selected-col;
    enabled:                    true;
    padding:                    0px 8px 0px 0px;
}

entry {
    background-color:           transparent;
    text-color:                 @fg-col;
    placeholder:                "Type to search...";
    placeholder-color:          #888888;
}

listview {
    background-color:           transparent;
    columns:                    8;
    lines:                      4;
    spacing:                    20px;
    cycle:                      true;
    dynamic:                    true;
    scrollbar:                  false;
    layout:                     vertical;
    fixed-height:               true;
    fixed-columns:              true;
}

element {
    background-color:           #1c1c1c80;
    padding:                    16px 10px;
    border-radius:              10px;
    orientation:                vertical;
    spacing:                    10px;
    border:                     1px;
    border-color:               transparent;
    children:                   [ element-icon, element-text ];
}

/* Explicitly remove Zebra Striping on Normal & Alternate rows */
element normal.normal,
element alternate.normal,
element normal.active,
element alternate.active {
    background-color:           #1c1c1c80;
    text-color:                 @fg-col;
}

element-icon {
    background-color:           transparent;
    size:                       48px;
    horizontal-align:           0.5;
}

element-text {
    background-color:           transparent;
    text-color:                 inherit;
    horizontal-align:           0.5;
    vertical-align:             0.5;
    font:                       "JetBrainsMono Nerd Font, monospace 9";
}

element selected.normal,
element selected.active {
    background-color:           @selected-col;
    text-color:                 @fg-col-active;
    border-color:               @border-col;
}

element-text selected {
    background-color:           transparent;
    text-color:                 @fg-col-active;
}