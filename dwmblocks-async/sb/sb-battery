#!/bin/sh

case $BLOCK_BUTTON in
	2) setsid -f alacritty -e nvim "$0" ;;
esac

# Find battery and AC power supply paths
BAT=$(ls -d /sys/class/power_supply/BAT* 2>/dev/null | head -n 1)
AC=$(ls -d /sys/class/power_supply/AC* /sys/class/power_supply/ADP* 2>/dev/null | head -n 1)

[ -z "$BAT" ] && exit 0

CAPACITY=$(cat "$BAT/capacity")
STATUS=$(cat "$BAT/status")

# Check if AC adapter is plugged in (1 = plugged, 0 = unplugged)
AC_ONLINE=0
[ -n "$AC" ] && [ -f "$AC/online" ] && AC_ONLINE=$(cat "$AC/online")

# Determine if charging
IS_CHARGING=0
[ "$AC_ONLINE" -eq 1 ] || [ "$STATUS" = "Charging" ] || [ "$STATUS" = "Full" ] && IS_CHARGING=1

if [ "$IS_CHARGING" -eq 1 ]; then
    # Granular Charging Icons
    if [ "$CAPACITY" -ge 99 ]; then
        ICON="󰂅" # Full Charging
    elif [ "$CAPACITY" -ge 80 ]; then
        ICON="󰂋"
    elif [ "$CAPACITY" -ge 60 ]; then
        ICON="󰂊"
    elif [ "$CAPACITY" -ge 40 ]; then
        ICON="󰂉"
    elif [ "$CAPACITY" -ge 20 ]; then
        ICON="󰂈"
    else
        ICON="󰂆" # Low Charging
    fi
else
    # 10-Tier Discharging Icons
    if [ "$CAPACITY" -ge 90 ]; then
        ICON="󰁹"
    elif [ "$CAPACITY" -ge 80 ]; then
        ICON="󰂂"
    elif [ "$CAPACITY" -ge 70 ]; then
        ICON="󰂁"
    elif [ "$CAPACITY" -ge 60 ]; then
        ICON="󰂀"
    elif [ "$CAPACITY" -ge 50 ]; then
        ICON="󰁿"
    elif [ "$CAPACITY" -ge 40 ]; then
        ICON="󰁾"
    elif [ "$CAPACITY" -ge 30 ]; then
        ICON="󰁽"
    elif [ "$CAPACITY" -ge 20 ]; then
        ICON="󰁼"
    elif [ "$CAPACITY" -ge 10 ]; then
        ICON="󰁻"
    else
        ICON="󰁺" # Critical / Empty
    fi
fi

# Output icon and percentage
echo "$ICON $CAPACITY%"
