#!/bin/sh

case "$BLOCK_BUTTON" in
    2) setsid -f alacritty -e nvim "$0" ;; 
    1)
        CHOICE=$(printf "Lock\nLogout\nReboot\nShutdown\nSuspend" | dmenu -i -p "Power Menu:")
        case "$CHOICE" in
            Lock)     setsid -f slock ;;
            Logout)   kill -HUP $(pgrep -u "$USER" dwm) ;;
            Reboot)   systemctl reboot ;;
            Shutdown) systemctl poweroff ;;
            Suspend)  systemctl suspend ;;
        esac
        ;;
esac

echo "  "
