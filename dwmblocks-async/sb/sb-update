#!/bin/sh

# Handle mouse click events from dwmblocks
case "$BLOCK_BUTTON" in
    3) setsid -f alacritty -e sh -c "sudo pacman -Syu; echo ''; echo 'Press Enter to close window...'; read" ;; 
    2) setsid -f alacritty -e nvim "$0" ;; 
esac

# Check for updates using the standard Arch utility
CUPD=$(checkupdates 2>/dev/null | wc -l)
[ -z "$CUPD" ] && CUPD=0

# Output based on update availability
if [ "$CUPD" -gt 0 ]; then
    echo "󰚰 ${CUPD} updates"
else
    echo "󰸟"
fi
