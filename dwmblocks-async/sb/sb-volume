#!/bin/sh

# Configuration: Set to 1 to show percentage/status text, 0 to show icon only
SHOW_PERCENTAGE=1

# Handle mouse click and scroll events from dwmblocks
case $BLOCK_BUTTON in
	2) setsid -f alacritty -e nvim "$0" ;;
	3) setsid -f pavucontrol ;;                            # Right-click: Open audio mixer GUI
	1) pactl set-sink-mute @DEFAULT_SINK@ toggle ;;      # Left-click: Toggle software mute
	4) pactl set-sink-volume @DEFAULT_SINK@ +5% ;;       # Scroll up: Increase volume by 5%
	5) pactl set-sink-volume @DEFAULT_SINK@ -5% ;;       # Scroll down: Decrease volume by 5%
esac

# Retrieve current audio states from PulseAudio/PipeWire
IS_MUTED=$(pactl get-sink-mute @DEFAULT_SINK@ | awk '{print $2}')

if [ "$IS_MUTED" = "yes" ]; then
    ICON="󰝟"
    TEXT="Muted"
else
    VOL=$(pactl get-sink-volume @DEFAULT_SINK@ | awk '/Volume:/ {print $5}' | tr -d '%')
    [ -z "$VOL" ] && VOL=0
    
    if [ "$VOL" -eq 0 ]; then
        ICON=""       # Unmuted, but flatlined at zero
        TEXT="0%"
    elif [ "$VOL" -le 25 ]; then
        ICON="" # Quiet (1% – 25%)
        TEXT="${VOL}%"
    elif [ "$VOL" -le 50 ]; then
        ICON="" # Medium-Low (26% – 50%)
        TEXT="${VOL}%"
    elif [ "$VOL" -le 75 ]; then
        ICON="" # Medium-High (51% – 75%)
        TEXT="${VOL}%"
    else
        ICON="" # Loud / Max (76% – 100%+)
        TEXT="${VOL}%"
    fi
fi

# Output based on the toggle switch
if [ "$SHOW_PERCENTAGE" -eq 1 ]; then
    echo "$ICON $TEXT"
else
    echo "$ICON"
fi
