#!/bin/sh

# Configuration: Set to 1 to show percentage, 0 to show circular gauge bar only
SHOW_PERCENTAGE=1
# Handle mouse click events from dwmblocks
case $BLOCK_BUTTON in
	2) setsid -f alacritty -e nvim "$0" ;;
	3) setsid -f thunar ;;
esac
# Reusable function to map any percentage (0-100) to a dynamic circular gauge bar
get_circle_bar() {
    v=$1
    [ -z "$v" ] && v=0
    if   [ "$v" -ge 88 ]; then echo "󰪥" # Full / Near Capacity
    elif [ "$v" -ge 76 ]; then echo "󰪤"
    elif [ "$v" -ge 63 ]; then echo "󰪣"
    elif [ "$v" -ge 51 ]; then echo "󰪢" # Half Full
    elif [ "$v" -ge 38 ]; then echo "󰪡"
    elif [ "$v" -ge 26 ]; then echo "󰪠"
    elif [ "$v" -ge 13 ]; then echo "󰪟"
    else                       echo "󰪞" # Empty / Low Usage
    fi
}

# 1. Root Partition (/) Usage
ROOT_VAL=$(df -h / | awk 'NR==2 {print $5}' | tr -d '%')
ROOT_BAR=$(get_circle_bar "$ROOT_VAL")

# 2. Home Partition (/home) Usage
HOME_VAL=$(df -h /home | awk 'NR==2 {print $5}' | tr -d '%')
HOME_BAR=$(get_circle_bar "$HOME_VAL")

# Output based on the toggle switch
if [ "$SHOW_PERCENTAGE" -eq 1 ]; then
    echo "󰋊 ${ROOT_BAR} ${ROOT_VAL}% |  ${HOME_BAR} ${HOME_VAL}%"
else
    echo "󰋊 ${ROOT_BAR} |  ${HOME_BAR}"
fi
