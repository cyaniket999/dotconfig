#!/usr/bin/env bash

WALLPAPER_DIR="$HOME/Pictures/backgrounds"

if [ ! -d "$WALLPAPER_DIR" ]; then
    notify-send "Wallpaper Error" "Directory $WALLPAPER_DIR does not exist."
    exit 1
fi

# Read current Pywal colors if they exist
if [ -f "$HOME/.cache/wal/colors" ]; then
    mapfile -t WAL_COLORS < "$HOME/.cache/wal/colors"
    BG="${WAL_COLORS[0]}"   # Background
    FG="${WAL_COLORS[7]}"   # Normal text
    SEL="${WAL_COLORS[2]}"  # Highlight accent
else
    # Default fallbacks
    BG="#222222"
    FG="#bbbbbb"
    SEL="#005577"
fi

# Run dmenu with smaller height (-l 6) and Pywal colors
SELECTED_WALL=$(ls "$WALLPAPER_DIR" | dmenu -i -l 3 -p "Select Wallpaper:" \
    -nb "$BG" -nf "$FG" \
    -sb "$SEL" -sf "$BG")

[ -z "$SELECTED_WALL" ] && exit 0

FULL_PATH="$WALLPAPER_DIR/$SELECTED_WALL"

# 1. Generate colors and set wallpaper
wal -i "$FULL_PATH"

# 2. Merge Pywal colors into X server memory
xrdb -merge ~/.cache/wal/colors.Xresources
[ -f ~/.cache/wal/dwm.Xresources ] && xrdb -merge ~/.cache/wal/dwm.Xresources

# 3. Cleanly restart dwm live via SIGHUP
pkill -HUP -x dwm

# 4. Re-bind dwmblocks
if pgrep -x dwmblocks >/dev/null; then
    pkill -x dwmblocks
    sleep 0.1
    nohup dwmblocks >/dev/null 2>&1 &
fi