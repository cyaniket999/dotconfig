#!/usr/bin/env bash

WALLPAPER_DIR="$HOME/Pictures/backgrounds"
DUNST_RELOAD="$HOME/.config/dunst/dunst.sh"

if [ ! -d "$WALLPAPER_DIR" ]; then
    notify-send "Wallpaper Error" "Directory $WALLPAPER_DIR does not exist."
    exit 1
fi

# Build wallpaper filename list
WALLPAPERS=$(find "$WALLPAPER_DIR" -maxdepth 1 -type f \( -iname "*.jpg" -o -iname "*.png" -o -iname "*.jpeg" \) -exec basename {} \;)

[ -z "$WALLPAPERS" ] && exit 0

# Import Pywal colors for dmenu if available
PYWAL_COLORS="$HOME/.cache/wal/colors.sh"
DMENU_ARGS=(-l 3 -p "Wallpaper:")

if [ -f "$PYWAL_COLORS" ]; then
    # Load background (bg), foreground (fg), accent color (color1/color2)
    source "$PYWAL_COLORS"
    DMENU_ARGS+=(
        -nb "$color0"
        -nf "$color7"
        -sb "$color2"
        -sf "$color0"
    )
fi

# Launch dmenu picker
SELECTED_WALL=$(echo "$WALLPAPERS" | dmenu "${DMENU_ARGS[@]}")

[ -z "$SELECTED_WALL" ] && exit 0

FULL_PATH="$WALLPAPER_DIR/$SELECTED_WALL"

# 1. Run Pywal and reload Dunst
if [ -x "$DUNST_RELOAD" ]; then
    wal -q -i "$FULL_PATH" -o "$DUNST_RELOAD"
else
    wal -q -i "$FULL_PATH"
fi

# 2. Merge Pywal Xresources
xrdb -merge ~/.Xresources

# 3. Live restart dwm
pkill -HUP -x dwm

# 4. Restart dwmblocks
if pgrep -x dwmblocks >/dev/null; then
    pkill -x dwmblocks
    sleep 0.1
    nohup dwmblocks >/dev/null 2>&1 &
fi